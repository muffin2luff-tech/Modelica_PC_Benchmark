connector Pin
  Real v;
  flow Real i;
end Pin;
model Ports0
  Pin in_n;
  Pin in_p;
  Pin out;
end Ports0;
model Ports1
  Pin n;
  Pin p;
end Ports1;
model Ports2
  Pin p;
end Ports2;
model Study
  Ports1 c;
  Ports2 ground;
  Ports1 l;
  Ports0 opAmp;
  Ports1 r;
  Ports1 r1;
  Ports1 r2;
  Ports1 vOut;
equation
  connect(opAmp.out, r.p);
  connect(opAmp.out, r2.p);
  connect(r2.n, r1.p);
  connect(r2.n, opAmp.in_n);
  connect(r.n, opAmp.in_p);
  connect(l.n, ground.p);
  connect(r.n, l.p);
  connect(c.p, l.p);
  connect(c.n, l.n);
  connect(ground.p, vOut.n);
  connect(r.n, vOut.p);
  connect(r1.n, vOut.n);
end Study;
