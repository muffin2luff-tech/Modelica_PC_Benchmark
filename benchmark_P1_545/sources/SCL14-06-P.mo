connector Pin
  Real v;
  flow Real i;
end Pin;
model Ports0
  Pin in_n;
  Pin in_p;
  Pin out;
end Ports0;
model Ports1
  Pin n;
  Pin p;
end Ports1;
model Ports2
  Pin p;
end Ports2;
model Study
  Ports2 ground;
  Ports0 opAmp;
  Ports1 r1;
  Ports1 r2;
  Ports1 vIn;
  Ports1 vOut;
equation
  connect(r1.p, r2.n);
  connect(ground.p, r1.n);
  connect(opAmp.out, r2.p);
  connect(r2.n, opAmp.in_p);
  connect(vIn.p, opAmp.in_n);
  connect(ground.p, vIn.n);
  connect(ground.p, vOut.n);
  connect(opAmp.out, vOut.p);
end Study;
